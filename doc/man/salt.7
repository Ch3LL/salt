.UNINDENT
.INDENT 7.0
.INDENT 3.5
.sp
.nf
.ft C
create_test_host:
    zabbix_host.present:
        \- host: TestHostWithInterfaces
        \- proxy_host: 12345
        \- groups:
            \- 5
            \- 6
            \- 7
        \- interfaces:
            \- test1.example.com:
                \- ip: \(aq192.168.1.8\(aq
                \- type: \(aqAgent\(aq
                \- port: 92
            \- testing2_create:
                \- ip: \(aq192.168.1.9\(aq
                \- dns: \(aqtest2.example.com\(aq
                \- type: \(aqagent\(aq
                \- main: false
            \- testovaci1_ipmi:
                \- ip: \(aq192.168.100.111\(aq
                \- type: \(aqipmi\(aq
        \- inventory:
            \- alias: some alias
            \- asset_tag: jlm3937
.ft P
.fi
