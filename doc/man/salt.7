   no
 );
};
.ft P
.fi
.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
t_demo_filetemplate:
  syslog_ng.config:
    \-config:
        template:
          \- template:
            \- \(aq"$ISODATE $HOST $MSG\en"\(aq
          \- template_escape:
            \- "no"
.ft P
.fi
.UNINDENT
.UNINDENT
.SS Rewrite
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
rewrite r_set_message_to_MESSAGE {
 set(
   "${.json.message}",
