.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
key_in_redis:
  redis.string:
    \- value: string data
    \- host: localhost
    \- port: 6379
    \- db: 0
    \- password: somuchkittycat
.ft P
.fi
