.INDENT 7.0
.TP
.B Return type
\fI\%bool\fP
.UNINDENT
.sp
Example of usage:
.INDENT 7.0
.INDENT 3.5
.sp
.nf
.ft C
site0\-webapp\-setting:
    win_iis.set_app:
        \- name: app0
        \- site: Default Web Site
        \- settings:
            userName: domain\e\euser
            password: pass
            physicalPath: c:\einetpub\ewwwroot
            applicationPool: appPool0
