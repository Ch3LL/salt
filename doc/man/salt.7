                Events:
                  \- "s3:ObjectCreated:*"
                Filter:
                  Key:
                    FilterRules:
                      \- Name: "prefix"
                        Value: "string"
        \- Policy:
            Version: "2012\-10\-17"
            Statement:
              \- Sid: "String"
                Effect: "Allow"
                Principal:
                  AWS: "arn:aws:iam::133434421342:root"
                Action: "s3:PutObject"
                Resource: "arn:aws:s3:::my\-bucket/*"
        \- Replication:
