      \- addressname: r\-10.0.0.1\-10.0.0.50
      \- vsys: 1
      \- iprange: 10.0.0.1\-10.0.0.50
      \- commit: False

panos/address/foo.bar.com:
    panos.address_exists:
      \- addressname: foo.bar.com
      \- vsys: 1
      \- fqdn: foo.bar.com
      \- description: My fqdn object
      \- commit: False
.ft P
