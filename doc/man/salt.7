.sp
.nf
.ft C
server\-warning\-message:
  smtp.send_msg:
    \- name: \(aqThis is a server warning message\(aq
    \- profile: my\-smtp\-account
    \- subject: \(aqMessage from Salt\(aq
    \- recipient: admin@example.com
    \- sender: admin@example.com
    \- use_ssl: True
    \- attachments:
        \- /var/log/syslog
