              Days: 123
            ID: "idstring"
            Prefix: "prefixstring"
            Status: "enabled",
            ID: "lc1"
            Transitions:
              \- Days: 123
                StorageClass: "GLACIER"
            NoncurrentVersionTransitions:
              \- NoncurrentDays: 123
                StorageClass: "GLACIER"
            NoncurrentVersionExpiration:
              NoncurrentDays: 123
        \- Logging:
