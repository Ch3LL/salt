.ft C
{{ [\(aq192.168.0.1\(aq, \(aqfoo\(aq, \(aqbar\(aq, \(aqfe80::\(aq] | ipaddr }}
.ft P
.fi
.UNINDENT
.UNINDENT
.sp
Returns:
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
["192.168.0.1", "fe80::"]
.ft P
.fi
.UNINDENT
.UNINDENT
