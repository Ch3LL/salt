        \- min_adjustment_step: None
        \- name: ScaleDown
        \- scaling_adjustment: \-1
    \- region: us\-east\-1
    \- keyid: GKTADJGHEIQSXMKKRBJ08H
    \- key: askdjghsdfjkghWupUjasdflkdfklgjsdfjajkghs

# Using a profile from pillars.
Ensure myasg exists:
  boto_asg.present:
    \- name: myasg
    \- launch_config_name: mylc
    \- availability_zones:
      \- us\-east\-1a
      \- us\-east\-1b
    \- min_size: 1
    \- max_size: 1
