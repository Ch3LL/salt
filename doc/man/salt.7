{{ \(aq/etc/salt/master\(aq | is_empty_file }}
.ft P
.fi
.UNINDENT
.UNINDENT
.sp
Returns:
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
False
.ft P
.fi
.UNINDENT
.UNINDENT
