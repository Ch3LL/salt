.INDENT 3.5
.sp
.nf
.ft C
eth0:
  ethtool.coalesce:
    \- name: eth0
    \- adaptive_rx: on
    \- adaptive_tx: on
    \- rx_usecs: 24
    \- rx_frame: 0
    \- rx_usecs_irq: 0
    \- rx_frames_irq: 0
    \- tx_usecs: 48
    \- tx_frames: 0
    \- tx_usecs_irq: 0
    \- tx_frames_irq: 0
    \- stats_block_usecs: 0
    \- pkt_rate_low: 0
    \- rx_usecs_low: 0
    \- rx_frames_low: 0
    \- tx_usecs_low: 0
    \- tx_frames_low: 0
    \- pkt_rate_high: 0
    \- rx_usecs_high: 0
    \- rx_frames_high: 0
    \- tx_usecs_high: 0
    \- tx_frames_high: 0
    \- sample_interval: 0
.ft P
.fi
