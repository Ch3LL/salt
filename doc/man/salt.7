.ft C
edge01.icn01:
    FOXW00F001
edge01.del01:
    FOXW00F002
edge01.yyz01:
    FOXW00F003
edge01.mrs01:
    FOXW00F004
.ft P
.fi
.UNINDENT
.UNINDENT
