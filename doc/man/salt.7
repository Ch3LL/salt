.UNINDENT
.sp
USAGE Example:
.INDENT 7.0
.INDENT 3.5
.sp
.nf
.ft C
conn = __salt__[\(aqnetmiko.get_connection\(aq](host=\(aqrouter1.example.com\(aq,
                                          username=\(aqexample\(aq,
                                          password=\(aqexample\(aq)
show_if = conn.send_command(\(aqshow interfaces\(aq)
conn.disconnect()
.ft P
.fi
