                  +    family inet {
                  +        /*
                  +         ** $Id: update_icmp_first_term $
                  +         ** $Date: 2017/02/30 $
                  +         **
                  +         */
                  +        filter block\-icmp {
                  +            term first\-term {
                  +                from {
                  +                    protocol icmp;
                  +                }
