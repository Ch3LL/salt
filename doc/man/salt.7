.ft C
baruwa:
  postgres_privileges.present:
    \- object_name: awl
    \- object_type: table
    \- privileges:
      \- SELECT
      \- INSERT
      \- DELETE
    \- grant_option: False
    \- prepend: public
    \- maintenance_db: testdb
.ft P
.fi
.UNINDENT
