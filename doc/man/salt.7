salt \(aq*\(aq pkg.remove <fileset/rpm package name>
salt \(aq*\(aq pkg.remove tcsh
salt \(aq*\(aq pkg.remove xlC.rte
salt \(aq*\(aq pkg.remove Firefox.base.adt
