  neutron_subnet.present:
    \- name: subnet1
    \- network_name_or_id: network1
    \- cidr: 192.168.199.0/24


delete subnet:
  neutron_subnet.absent:
    \- name: subnet2

create subnet with optional params:
  neutron_subnet.present:
    \- name: subnet1
    \- network_name_or_id: network1
    \- enable_dhcp: True
    \- cidr: 192.168.199.0/24
    \- allocation_pools:
      \- start: 192.168.199.5
        end: 192.168.199.250
    \- host_routes:
      \- destination: 192.168..0.0/24
        nexthop: 192.168.0.1
    \- gateway_ip: 192.168.199.1
    \- dns_nameservers:
      \- 8.8.8.8
      \- 8.8.8.7

create ipv6 subnet:
  neutron_subnet.present:
    \- name: v6subnet1
    \- network_name_or_id: network1
    \- ip_version: 6
.ft P
.fi
