 );
};
.ft P
.fi
.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
r_set_message_to_MESSAGE:
  syslog_ng.config:
    \- config:
        rewrite:
          \- set:
            \- \(aq"${.json.message}"\(aq
            \- value : \(aq"$MESSAGE"\(aq
.ft P
.fi
