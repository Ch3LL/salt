all
.UNINDENT
.SS Complete Example
.INDENT 0.0
.INDENT 3.5
.sp
.nf
.ft C
postgres:
  user: \(aqsalt\(aq
  pass: \(aqsuper_secret_password\(aq
  db: \(aqsalt_db\(aq

ext_pillar:
  \- postgres:
      fromdb:
        query: \(aqSELECT col1,col2,col3,col4,col5,col6,col7
                  FROM some_random_table
                 WHERE minion_pattern LIKE %s\(aq
        depth: 5
        as_list: True
        with_lists: [1,3]
.ft P
.fi
