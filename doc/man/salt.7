.TP
.B Parameters
\fBname\fP \-\- May be a Salt_id node, or a POSIX\-style wildcard string.
.UNINDENT
.INDENT 7.0
.INDENT 3.5
.sp
.nf
.ft C
node_name:
  vagrant.stopped
.ft P
.fi
