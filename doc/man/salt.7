        +    probe new_probe {
        +        test new_test1 {
        +            probe\-type icmp\-ping;
        +            target address 192.168.0.1;
        +            probe\-count 13;
        +            test\-interval 3;
        +            source\-address 192.168.0.2;
        +        }
        +    }
    result:
        True
.ft P
.fi
